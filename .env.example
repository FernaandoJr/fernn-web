# Reference for all environment variables in this monorepo.
# Copy values into app-specific files (do not commit secrets):
#   apps/web/.env.local   — Next.js public vars
#   apps/api/.env         — API server (see apps/api/.env.example)

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_INVITE_URL=

# --- apps/api ---
MONGODB_URI=mongodb://127.0.0.1:27017/fernn
API_URL=http://localhost:8787
WEB_APP_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
